---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import { allProjects } from "../../data/projects";

export function getStaticPaths() {
  return allProjects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const trackLabel = project.track === "work" ? "Professional work" : "Home & maker builds";
const trackColor = project.track === "work" ? "text-accent border-accent/30" : "text-maker border-maker/30";
---

<Base title={`${project.title} — Ethan Desilets`} description={project.summary}>
  <Nav />

  <main class="pt-28 pb-24 px-6 min-h-screen">
    <div class="max-w-3xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 font-mono text-xs text-text-muted mb-12">
        <a href="/" class="hover:text-text-secondary transition-colors">Home</a>
        <span>/</span>
        <a href="/#projects" class="hover:text-text-secondary transition-colors">Projects</a>
        <span>/</span>
        <span class="text-text-secondary">{project.title}</span>
      </nav>

      <!-- Header -->
      <div class="mb-12">
        <span class={`inline-block font-mono text-[10px] px-2.5 py-1 rounded-full border ${trackColor} mb-4`}>
          {trackLabel}
        </span>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-text-primary mb-4">
          {project.title}
        </h1>
        <p class="font-mono text-sm text-text-secondary leading-relaxed">
          {project.summary}
        </p>
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-12">
        {project.tags.map((tag) => (
          <span class={`font-mono text-[11px] px-3 py-1 rounded-full border ${trackColor}`}>
            {tag}
          </span>
        ))}
      </div>

      <!-- Description -->
      <div class="bg-bg-surface border border-bg-border rounded-xl p-8 mb-8">
        <h2 class="font-display font-semibold text-lg text-text-primary mb-4">Overview</h2>
        <p class="font-mono text-sm text-text-secondary leading-relaxed">
          {project.description}
        </p>
      </div>

      <!-- Placeholder for full case study content -->
      <div class="bg-bg-elevated border border-dashed border-bg-border rounded-xl p-8 text-center">
        <p class="font-mono text-xs text-text-muted">Full case study coming soon</p>
      </div>

      <!-- Back -->
      <div class="mt-12">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 font-mono text-xs text-text-secondary hover:text-text-primary transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          Back to projects
        </a>
      </div>

    </div>
  </main>
</Base>
