---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { allMaker } from "../../data/projects";
---

<Base title="Home & maker builds — Ethan Desilets" description="Hardware, embedded, and home lab projects.">
  <Nav />

  <main class="pt-28 pb-24 px-6 min-h-screen">
    <div class="max-w-5xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 font-mono text-xs text-text-muted mb-12">
        <a href="/" class="hover:text-text-secondary transition-colors">Home</a>
        <span>/</span>
        <a href="/#projects" class="hover:text-text-secondary transition-colors">Projects</a>
        <span>/</span>
        <span class="text-text-secondary">Home & maker builds</span>
      </nav>

      <!-- Header -->
      <div class="flex items-center justify-between mb-10">
        <div>
          <h1 class="font-display font-bold text-4xl md:text-5xl text-text-primary mb-2">Home & maker builds</h1>
          <p class="font-mono text-sm text-text-secondary">Hardware, embedded systems, and home lab experiments.</p>
        </div>
        <span class="font-mono text-[10px] px-2.5 py-1 rounded-full border border-maker/30 text-maker/70 self-start mt-2">
          hardware · embedded · home lab
        </span>
      </div>

      <!-- Grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {allMaker.map((p) => (
          <ProjectCard slug={p.slug} title={p.title} summary={p.summary} tags={p.tags} track={p.track} />
        ))}
      </div>

      <!-- Back -->
      <div class="mt-12">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 font-mono text-xs text-text-secondary hover:text-text-primary transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          Back to projects
        </a>
      </div>

    </div>
  </main>
</Base>
